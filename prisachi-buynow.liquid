{% if shop.metafields.judgeme.all_reviews_rating != blank and shop.metafields.judgeme.all_reviews_count != blank %}
  <div class="prisachi-buy-now-trust" data-prisachi-trust>
    <div class="prisachi-buy-now-trust__source" aria-hidden="true">
      <div class='jdgm-widget jdgm-all-reviews-text'>
        <a href='javascript:void(0)'>
          <span data-score='{{ shop.metafields.judgeme.all_reviews_rating }}' class='jdgm-all-reviews-rating'></span>
          <span class='jdgm-all-reviews-text__text' data-score='{{ shop.metafields.judgeme.all_reviews_rating }}' data-number-of-reviews='{{ shop.metafields.judgeme.all_reviews_count }}' data-locale='en'>
            Customers rate us {{ shop.metafields.judgeme.all_reviews_rating | round: 1 }}/5 based on {{ shop.metafields.judgeme.all_reviews_count }} reviews.
          </span>
        </a>
      </div>
    </div>

    <div class="prisachi-buy-now-trust__card">
      <p class="prisachi-buy-now-trust__heading">
        <span class="prisachi-buy-now-trust__heart" aria-hidden="true">&#10084;</span>
        Trusted by <span class="prisachi-buy-now-trust__count" data-trust-count>55,000+</span> Happy Customers
      </p>

      <div class="prisachi-buy-now-trust__body">
        <div class="prisachi-buy-now-trust__avatars" aria-hidden="true">
          {% for i in (1..4) %}
            <img
              class="prisachi-buy-now-trust__avatar"
              src="https://dummyimage.com/120x120/f1d7df/3f2f35.jpg&text=%20"
              alt=""
              loading="lazy"
              width="58"
              height="58"
            >
          {% endfor %}
        </div>

        <div class="prisachi-buy-now-trust__summary">
          <span class="prisachi-buy-now-trust__rating-value" data-rating-value>4.8/5</span>
          <p class="prisachi-buy-now-trust__caption">Average Rating</p>
        </div>

        <div class="prisachi-buy-now-trust__stars" aria-hidden="true">
          {% for i in (1..5) %}
            <svg viewBox="0 0 24 24" class="prisachi-buy-now-trust__star">
              <path d="M12 2.75l2.84 5.75 6.35.92-4.59 4.47 1.08 6.33L12 17.24l-5.68 2.98 1.08-6.33L2.81 9.42l6.35-.92L12 2.75Z" fill="currentColor"></path>
            </svg>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <style>
    .prisachi-buy-now-trust {
      width: 100%;
      margin: 0 0 16px;
    }

    .prisachi-buy-now-trust__source {
      display: none;
    }

    .prisachi-buy-now-trust__card {
      padding: 20px 28px 18px;
      border-radius: 16px;
      background: linear-gradient(180deg, #fffefe 0%, #fff8fb 100%);
      border: 1px solid #f4edf1;
      box-shadow: 0 8px 20px rgba(77, 48, 58, 0.06);
    }

    .prisachi-buy-now-trust__heading {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 7px;
      margin: 0 0 18px;
      color: #211b1e;
      font-size: 16px;
      line-height: 1.2;
      font-weight: 700;
      text-align: center;
    }

    .prisachi-buy-now-trust__heart {
      color: #f35c87;
      font-size: 15px;
      line-height: 1;
    }

    .prisachi-buy-now-trust__body {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) auto auto;
      align-items: center;
      column-gap: 34px;
    }

    .prisachi-buy-now-trust__avatars {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding-left: 6px;
      min-width: 0;
    }

    .prisachi-buy-now-trust__avatar {
      width: 58px;
      height: 58px;
      border-radius: 999px;
      object-fit: cover;
      border: 3px solid #ffffff;
      box-shadow: 0 6px 12px rgba(61, 31, 42, 0.12);
      margin-left: -14px;
      background: #f3dbe2;
    }

    .prisachi-buy-now-trust__avatar:first-child {
      margin-left: 0;
    }

    .prisachi-buy-now-trust__summary {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-width: 120px;
    }

    .prisachi-buy-now-trust__rating-value {
      color: #171416;
      font-size: 18px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .prisachi-buy-now-trust__caption {
      margin: 6px 0 0;
      color: #3a3437;
      font-size: 14px;
      line-height: 1.2;
      font-weight: 600;
    }

    .prisachi-buy-now-trust__stars {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 4px;
      color: #ffbe1a;
    }

    .prisachi-buy-now-trust__star {
      width: 26px;
      height: 26px;
      flex: 0 0 26px;
      display: block;
    }

    @media screen and (max-width: 749px) {
      .prisachi-buy-now-trust__card {
        padding: 14px 14px 12px;
        border-radius: 14px;
      }

      .prisachi-buy-now-trust__heading {
        margin-bottom: 14px;
        font-size: 14px;
      }

      .prisachi-buy-now-trust__body {
        grid-template-columns: 1fr;
        row-gap: 12px;
        justify-items: center;
      }

      .prisachi-buy-now-trust__avatars {
        padding-left: 0;
      }

      .prisachi-buy-now-trust__avatar {
        width: 48px;
        height: 48px;
        margin-left: -12px;
      }

      .prisachi-buy-now-trust__summary {
        min-width: 0;
      }

      .prisachi-buy-now-trust__rating-value {
        font-size: 16px;
      }

      .prisachi-buy-now-trust__caption {
        font-size: 12px;
      }

      .prisachi-buy-now-trust__star {
        width: 20px;
        height: 20px;
        flex-basis: 20px;
      }
    }
  </style>

  <script>
    (function () {
      var wrappers = document.querySelectorAll('[data-prisachi-trust]');
      wrappers.forEach(function (wrapper) {
        var summaryText = wrapper.querySelector('.jdgm-all-reviews-text__text');
        if (!summaryText) return;

        var ratingValue = parseFloat(summaryText.getAttribute('data-score') || '0');
        var reviewCount = parseInt(summaryText.getAttribute('data-number-of-reviews') || '0', 10);
        var ratingTarget = wrapper.querySelector('[data-rating-value]');
        var countTarget = wrapper.querySelector('[data-trust-count]');

        if (ratingTarget && !Number.isNaN(ratingValue)) {
          ratingTarget.textContent = ratingValue.toFixed(1) + '/5';
        }

        if (countTarget && !Number.isNaN(reviewCount) && reviewCount > 0) {
          countTarget.textContent = reviewCount + '+';
        }
      });
    })();
  </script>
{% endif %}
