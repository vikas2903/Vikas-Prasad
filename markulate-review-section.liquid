{% assign testimonial_id = 'markleute-testimonials-' | append: section.id %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">

<section id="{{ testimonial_id }}" class="markleute-testimonials">
  <div class="markleute-testimonials__inner">
    <header class="markleute-testimonials__header">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.review_summary != blank %}
        <p><span aria-hidden="true">&#9733;</span>{{ section.settings.review_summary | escape }}</p>
      {% endif %}
    </header>

    <div class="splide markleute-testimonials__slider" aria-label="Customer testimonials">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            {% capture demo_image %}https://images.unsplash.com/photo-{% cycle '1558618666-fcd25c85cd64', '1610030469983-98e550d6193c', '1603252109303-2751441dd157', '1583391733956-6c78276477e2', '1608234807905-4466023792f5' %}?auto=format&fit=crop&w=900&q=85{% endcapture %}
            <li class="splide__slide" {{ block.shopify_attributes }}>
              <article class="markleute-testimonials__card">
                <div class="markleute-testimonials__image-wrap">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 900 | image_tag: class: 'markleute-testimonials__image', loading: 'lazy', widths: '350, 500, 700, 900', alt: block.settings.customer_name }}
                  {% else %}
                    <img class="markleute-testimonials__image" src="{{ demo_image | strip }}" alt="Customer review from {{ block.settings.customer_name | escape }}" loading="lazy" width="900" height="900">
                  {% endif %}
                </div>
                <div class="markleute-testimonials__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {% for star in (1..5) %}
                    <span aria-hidden="true" class="{% if star > block.settings.rating %}is-empty{% endif %}">&#9733;</span>
                  {% endfor %}
                </div>
                <div class="markleute-testimonials__content">
                  {% if block.settings.customer_name != blank %}
                    <h3>{{ block.settings.customer_name | escape }}</h3>
                  {% endif %}
                  {% if block.settings.review != blank %}
                    <p>{{ block.settings.review | escape | newline_to_br }}</p>
                  {% endif %}
                </div>
              </article>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  #{{ testimonial_id }} { padding: {{ section.settings.padding_top }}px 28px {{ section.settings.padding_bottom }}px; overflow: hidden; background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; }
  #{{ testimonial_id }} .markleute-testimonials__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  #{{ testimonial_id }} .markleute-testimonials__header { margin: 0 auto 24px; text-align: center; }
  #{{ testimonial_id }} .markleute-testimonials__header h2 { margin: 0; font-size: clamp(26px, 2.4vw, 36px); font-weight: 750; letter-spacing: -.035em; line-height: 1.12; }
  #{{ testimonial_id }} .markleute-testimonials__header p { display: inline-flex; align-items: center; gap: 6px; margin: 9px 0 0; padding: 6px 11px; border: 1px solid rgba(17, 17, 17, .08); border-radius: 999px; background: rgba(255, 255, 255, .72); color: {{ section.settings.text_color }}; font-size: 12px; font-weight: 650; line-height: 1.2; letter-spacing: .01em; }
  #{{ testimonial_id }} .markleute-testimonials__header p span { color: #e9a800; font-size: 14px; }
  #{{ testimonial_id }} .splide__track { overflow: visible; padding: 2px 2px 14px; }
  #{{ testimonial_id }} .splide__list { align-items: stretch; }
  #{{ testimonial_id }} .splide__slide { display: flex; height: auto; }
  #{{ testimonial_id }} .markleute-testimonials__card { position: relative; display: flex; flex: 1; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid rgba(17, 17, 17, .1); border-radius: 14px; background: #fff; color: #171717; box-shadow: 0 5px 18px rgba(17, 17, 17, .06); transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
  #{{ testimonial_id }} .markleute-testimonials__card:hover { border-color: rgba(17, 17, 17, .2); box-shadow: 0 10px 28px rgba(17, 17, 17, .1); transform: translateY(-3px); }
  #{{ testimonial_id }} .markleute-testimonials__image-wrap { aspect-ratio: 4 / 3; overflow: hidden; background: #eceae7; }
  #{{ testimonial_id }} .markleute-testimonials__image { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  #{{ testimonial_id }} .markleute-testimonials__card:hover .markleute-testimonials__image { transform: scale(1.025); }
  #{{ testimonial_id }} .markleute-testimonials__rating { position: relative; z-index: 1; align-self: flex-start; display: flex; gap: 1px; justify-content: center; margin: -13px 0 0 14px; padding: 6px 10px; border-radius: 999px; background: #171717; color: #ffc83d; box-shadow: 0 4px 12px rgba(0, 0, 0, .16); font-size: 12px; line-height: 1; }
  #{{ testimonial_id }} .markleute-testimonials__rating .is-empty { color: #666; }
  #{{ testimonial_id }} .markleute-testimonials__content { flex: 1; padding: 11px 15px 17px; }
  #{{ testimonial_id }} .markleute-testimonials__content h3 { margin: 0 0 7px; font-size: 15px; font-weight: 750; line-height: 1.25; }
  #{{ testimonial_id }} .markleute-testimonials__content p { margin: 0; color: #595959; font-size: 13px; font-weight: 400; line-height: 1.52; }
  #{{ testimonial_id }} .splide__arrow { width: 38px; height: 38px; border: 1px solid rgba(17, 17, 17, .12); background: #fff; opacity: 1; box-shadow: 0 5px 16px rgba(0,0,0,.13); transition: background .2s ease, transform .2s ease; }
  #{{ testimonial_id }} .splide__arrow:hover { background: #171717; }
  #{{ testimonial_id }} .splide__arrow svg { fill: #111; }
  #{{ testimonial_id }} .splide__arrow:hover svg { fill: #fff; }
  #{{ testimonial_id }} .splide__arrow--prev { left: -18px; }
  #{{ testimonial_id }} .splide__arrow--next { right: -18px; }
  #{{ testimonial_id }} .splide__pagination { bottom: -15px; }
  #{{ testimonial_id }} .splide__pagination__page { width: 6px; height: 6px; margin: 4px; background: #979797; opacity: .55; transition: width .2s ease, border-radius .2s ease; }
  #{{ testimonial_id }} .splide__pagination__page.is-active { width: 18px; border-radius: 5px; background: #171717; opacity: 1; transform: none; }
  @media screen and (prefers-reduced-motion: reduce) {
    #{{ testimonial_id }} .markleute-testimonials__card,
    #{{ testimonial_id }} .markleute-testimonials__image,
    #{{ testimonial_id }} .splide__arrow,
    #{{ testimonial_id }} .splide__pagination__page { transition: none; }
  }
  @media screen and (max-width: 749px) {
    #{{ testimonial_id }} { padding: {{ section.settings.padding_top | at_most: 48 }}px 16px {{ section.settings.padding_bottom | at_most: 48 }}px; }
    #{{ testimonial_id }} .markleute-testimonials__header { margin-bottom: 19px; }
    #{{ testimonial_id }} .markleute-testimonials__header h2 { font-size: 26px; }
    #{{ testimonial_id }} .markleute-testimonials__header p { font-size: 11px; }
    #{{ testimonial_id }} .markleute-testimonials__content { padding: 11px 14px 16px; }
    #{{ testimonial_id }} .splide__arrow { width: 34px; height: 34px; }
    #{{ testimonial_id }} .splide__arrow--prev { left: -7px; }
    #{{ testimonial_id }} .splide__arrow--next { right: -7px; }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
<script>
  (function () {
    var slider = document.querySelector('#{{ testimonial_id }} .markleute-testimonials__slider');
    if (!slider || !window.Splide || slider.classList.contains('is-initialized')) return;
    var slideCount = {{ section.blocks.size }};

    if (!slideCount) return;

    new Splide(slider, {
      type: slideCount > 5 ? 'loop' : 'slide',
      perPage: Math.min(slideCount, 5),
      perMove: 1,
      gap: 14,
      pagination: true,
      arrows: slideCount > 1,
      rewind: true,
      speed: 550,
      drag: slideCount > 1,
      breakpoints: {
        1199: { perPage: Math.min(slideCount, 4), gap: 12 },
        989: { perPage: Math.min(slideCount, 3), gap: 12 },
        749: { perPage: Math.min(slideCount, 2), gap: 10 },
        479: { perPage: 1, gap: 10, padding: { left: '3px', right: '24px' } }
      }
    }).mount();
  })();
</script>

{% schema %}
{
  "name": "Vs testimonials",
  "tag": "section",
  "class": "section-markleute-testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our customers love us" },
    { "type": "text", "id": "review_summary", "label": "Review summary", "default": "4.8 star based on 13,482 reviews" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f7f7" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#111111" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 900, "max": 1800, "step": 20, "default": 1440, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 100, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 100, "step": 4, "default": 32, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer image" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Customer name" },
        { "type": "textarea", "id": "review", "label": "Review", "default": "Beautiful quality and a lovely shopping experience." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vs testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "customer_name": "Ananya", "review": "The quality feels premium and the fit is exactly as expected." } },
        { "type": "testimonial", "settings": { "customer_name": "Meera", "review": "Beautiful piece, thoughtfully packed and delivered with care." } },
        { "type": "testimonial", "settings": { "customer_name": "Renu", "review": "Lovely style and fabric. I am very happy with my purchase." } },
        { "type": "testimonial", "settings": { "customer_name": "Jaya D.", "review": "Comfortable, elegant and truly worth adding to my wardrobe." } },
        { "type": "testimonial", "settings": { "customer_name": "Simran", "review": "A wonderful experience from order to delivery." } }
      ]
    }
  ]
}
{% endschema %}
