}
.wrapper-timer {
    {% comment %} border: 1px solid #000; {% endcomment %}
    {% comment %} border-bottom: 0; {% endcomment %}
     margin-bottom: 0 !important;
    {% comment %} padding: 20px 0 30px; {% endcomment %}
}

img.timer-cupon {
    display: block !important;
    {% comment %} border: 2px solid #000; {% endcomment %}
      border-top: 0;
      margin-top:0;
  
}
.timer-wrapper p {
    margin: 0;
    text-align: center;
    margin-bottom: 4px;
    font-size: 1.6rem;
}
@media(max-width: 768px){
  .timer-wrapper > h4{
      font-size: 22px;
  }
  .wrapper-timer {
      {% comment %} border: 1px solid #000; {% endcomment %}
      {% comment %} border-bottom: 0; {% endcomment %}
      {% comment %} padding: 0px 0 20px; {% endcomment %}
      margin-top: -10px !important;
  }
} 
.wrapper-timer.timer-collection {
    padding: 10px;
}
  
</style>
<div class="wrapper-timer timer-{{ template }}"> 
  <div class="timer-wrapper">
    <h4 style="text-align: center;"> Sale Ends In</h4>
    
      <div class="count-down">
          <div class="flipdown" id="flipdown"></div>
      </div>   
  </div>
</div>
