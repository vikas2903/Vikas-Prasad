    position: relative;
    padding: 0px 0 0;
    overflow: hidden;
}
.template--product .timer-wrapper{
    padding: 0px 0;
    margin-bottom: 10px;
    /* border-radius: 20px; */
}



#flipdown .rotor-group:first-child {
    display: none;
}
.rotor-group-heading{
  display: block !important;
}
.timer-wrapper > h4 {
    font-size: 32px;
    margin: 0 0 5px;
