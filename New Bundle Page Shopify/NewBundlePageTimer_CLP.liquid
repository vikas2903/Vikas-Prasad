<img class="timer-cupon" style="width: 100%; display: block;"src="https://cdn.shopify.com/s/files/1/0868/6272/5430/files/004-diwali-special-offer-banner-website-26-sept-new-sizee-birch-posh.png?v=1759339146" />
{% comment %} <img class="timer-cupon" style="width: 100%; display: block;"src="https://cdn.shopify.com/s/files/1/0796/1814/6613/files/Prisachi_3.png?v=1753439839" /> {% endcomment %}

  {% endif %} {% endcomment %}
  <!-- Scripts -->
<script src="https://pbutcher.uk/flipdown/js/flipdown/flipdown.js"></script>
<script>



  document.addEventListener('DOMContentLoaded', () => {
    function setCountdown() {
      const timer = document.querySelector('#flipdown');
      if (!timer) return;

      // Count down to the next local midnight. The offer timer therefore renews
      // every day without changing dates in this file.
      const now = new Date();
      const nextMidnight = new Date(now);
      nextMidnight.setHours(24, 0, 0, 0);
      const targetTimestamp = Math.floor(nextMidnight.getTime() / 1000);

      timer.innerHTML = '';
      new FlipDown(targetTimestamp)
        .start()
        .ifEnded(() => {
          timer.innerHTML = '';
          setTimeout(setCountdown, 1000);
        });
    }

    setCountdown();
  });


</script>
