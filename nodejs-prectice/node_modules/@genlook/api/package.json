{
  "name": "@genlook/api",
  "version": "0.6.0",
  "description": "Official TypeScript SDK for the Genlook API. A powerful virtual try-on API for clothing, accessories, and petwear. Add photorealistic AI virtual try-on to any app or store.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "virtual try-on",
    "virtual try on",
    "virtual try-on api",
    "ai try-on",
    "virtual fitting room",
    "clothing try-on",
    "petwear try-on",
    "genlook",
    "ai",
    "fashion",
    "ecommerce",
    "visual-commerce",
    "api",
    "sdk"
  ],
  "homepage": "https://genlook.app/docs/tryon-api/introduction",
  "bugs": {
    "url": "mailto:support@genlook.app"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@genlook/api-schemas": "0.1.1",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "pnpm run build && node --test 'test/*.test.mjs'",
    "prebuild": "pnpm --filter @genlook/api-schemas build"
  }
}