{%- liquid
  assign fabric_collection = section.settings.collection
  assign initial_count = section.settings.initial_products
  assign units_per_metre = section.settings.units_per_metre
-%}

<section
  id="fabric-sale-{{ section.id }}"
  class="fabric-sale"
  data-fabric-sale
  data-products-url="{% if fabric_collection != blank %}{{ fabric_collection.url }}/products.json?limit=250{% endif %}"
  data-initial-count="{{ initial_count }}"
  data-batch-size="{{ section.settings.products_per_load }}"
  data-units-per-metre="{{ units_per_metre }}"
  data-metre-label="{{ section.settings.metre_label | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <style>
    #fabric-sale-{{ section.id }} {
      --fabric-pink: {{ section.settings.primary_color }};
      --fabric-pink-dark: #9f0758;
      --fabric-ink: #23131c;
      --fabric-cream: #fff8fb;
      --fabric-blush: #fff0f7;
      --fabric-line: rgba(206, 17, 120, .17);
      --fabric-muted: #79636e;
      --fabric-wrap: min(1360px, 100% - 40px);
      color: var(--fabric-ink);
      background: var(--fabric-cream);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      overflow: clip;
    }
    #fabric-sale-{{ section.id }} *, #fabric-sale-{{ section.id }} *::before, #fabric-sale-{{ section.id }} *::after { box-sizing: border-box; }
    #fabric-sale-{{ section.id }} img { display: block; max-width: 100%; }
    #fabric-sale-{{ section.id }} button, #fabric-sale-{{ section.id }} input { font: inherit; }
    #fabric-sale-{{ section.id }} :focus-visible { outline: 3px solid var(--fabric-pink); outline-offset: 3px; }
    #fabric-sale-{{ section.id }} .fabric-wrap { width: var(--fabric-wrap); margin-inline: auto; }
    #fabric-sale-{{ section.id }} .fabric-sr { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    /* Banner */
    #fabric-sale-{{ section.id }} .fabric-hero { position: relative; min-height: min(610px, 76svh); isolation: isolate; display: grid; align-items: stretch; overflow: hidden; background: #2b1020; }
    #fabric-sale-{{ section.id }} .fabric-hero__image { position: absolute; inset: 0; z-index: -2; }
    #fabric-sale-{{ section.id }} .fabric-hero__image img { width: 100%; height: 100%; object-fit: cover; }
    #fabric-sale-{{ section.id }} .fabric-hero__image::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(35,19,28,.92) 0%, rgba(35,19,28,.74) 42%, rgba(35,19,28,.22) 100%); }
    #fabric-sale-{{ section.id }} .fabric-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 74% 28%, rgba(206,17,120,.52), transparent 26%), radial-gradient(circle at 98% 100%, rgba(255,171,210,.25), transparent 28%), linear-gradient(115deg, #250e1b 0%, #64103d 46%, #d41475 160%); }
    #fabric-sale-{{ section.id }} .fabric-hero__content { width: var(--fabric-wrap); margin-inline: auto; padding: clamp(62px, 9vw, 125px) 0; display: flex; align-items: center; }
    #fabric-sale-{{ section.id }} .fabric-hero__copy { max-width: 650px; color: #fff; }
    #fabric-sale-{{ section.id }} .fabric-eyebrow { display: inline-flex; align-items: center; gap: 9px; color: #ffd5e9; font-size: .73rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
    #fabric-sale-{{ section.id }} .fabric-eyebrow::before { content: ""; width: 30px; height: 1px; background: currentColor; }
    #fabric-sale-{{ section.id }} .fabric-hero h1 { max-width: 12ch; margin: 18px 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(3rem, 7.3vw, 6.6rem); font-weight: 400; line-height: .89; letter-spacing: -.065em; }
    #fabric-sale-{{ section.id }} .fabric-hero__copy p { max-width: 48ch; margin: 0; color: #ffe9f4; font-size: clamp(1rem, 1.4vw, 1.18rem); line-height: 1.6; }
    #fabric-sale-{{ section.id }} .fabric-hero__offer { display: inline-flex; margin-top: 31px; padding: 11px 16px; color: #fff; background: var(--fabric-pink); border-radius: 999px; box-shadow: 0 14px 32px -12px rgba(206,17,120,.75); font-size: .78rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }

    /* Daily countdown */
    #fabric-sale-{{ section.id }} .fabric-countdown { background: var(--fabric-pink); color: #fff; }
    #fabric-sale-{{ section.id }} .fabric-countdown__inner { width: var(--fabric-wrap); min-height: 70px; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
    #fabric-sale-{{ section.id }} .fabric-countdown__intro { font-size: .65rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    #fabric-sale-{{ section.id }} .fabric-countdown__intro strong { display: block; margin-top: 2px; font-family: Georgia, "Times New Roman", serif; font-size: 1.05rem; font-weight: 400; letter-spacing: -.03em; text-transform: none; }
    #fabric-sale-{{ section.id }} .fabric-clock { display: flex; align-items: center; }
    #fabric-sale-{{ section.id }} .fabric-clock__unit { min-width: 58px; padding: 0 10px; text-align: center; }
    #fabric-sale-{{ section.id }} .fabric-clock__unit + .fabric-clock__unit { border-left: 1px solid rgba(255,255,255,.38); }
    #fabric-sale-{{ section.id }} .fabric-clock__unit b { display: block; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.35rem, 2.4vw, 2rem); font-weight: 400; font-variant-numeric: tabular-nums; line-height: 1; }
    #fabric-sale-{{ section.id }} .fabric-clock__unit span { display: block; margin-top: 3px; font-size: .54rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }

    /* Collection grid */
    #fabric-sale-{{ section.id }} .fabric-products { padding: clamp(30px, 5vw, 64px) 0; }
    #fabric-sale-{{ section.id }} .fabric-products__head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
    #fabric-sale-{{ section.id }} .fabric-products__head h2 { max-width: 15ch; margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.85rem, 3.6vw, 3rem); font-weight: 400; line-height: .96; letter-spacing: -.05em; }
    #fabric-sale-{{ section.id }} .fabric-products__head p { max-width: 32ch; margin: 0; color: var(--fabric-muted); font-size: .84rem; line-height: 1.5; }
    #fabric-sale-{{ section.id }} .fabric-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
    #fabric-sale-{{ section.id }} .fabric-card { min-width: 0; position: relative; background: #fff; border: 1px solid var(--fabric-line); border-radius: 9px; overflow: hidden; box-shadow: 0 13px 28px -25px rgba(58, 11, 34, .65); transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease; }
    #fabric-sale-{{ section.id }} .fabric-card:hover { transform: translateY(-6px); border-color: rgba(206,17,120,.45); box-shadow: 0 26px 48px -28px rgba(84, 9, 49, .42); }
    #fabric-sale-{{ section.id }} .fabric-card__media { position: relative; display: block; aspect-ratio: .82; overflow: hidden; background: var(--fabric-blush); }
    #fabric-sale-{{ section.id }} .fabric-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.1,1); }
    #fabric-sale-{{ section.id }} .fabric-card:hover .fabric-card__media img { transform: scale(1.06); }
    #fabric-sale-{{ section.id }} .fabric-card__badge { position: absolute; left: 8px; top: 8px; padding: 5px 7px; border-radius: 999px; color: #fff; background: var(--fabric-pink); box-shadow: 0 8px 16px -9px rgba(154,0,78,.75); font-size: .52rem; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
    #fabric-sale-{{ section.id }} .fabric-card__body { display: flex; min-height: 165px; flex-direction: column; padding: 11px; }
    #fabric-sale-{{ section.id }} .fabric-card__title { margin: 0; color: var(--fabric-ink); font-family: Georgia, "Times New Roman", serif; font-size: .98rem; font-weight: 400; line-height: 1.12; }
    #fabric-sale-{{ section.id }} .fabric-card__title a { color: inherit; text-decoration: none; }
    #fabric-sale-{{ section.id }} .fabric-card__title a:hover { color: var(--fabric-pink); }
    #fabric-sale-{{ section.id }} .fabric-price { margin: 10px 0 0; }
    #fabric-sale-{{ section.id }} .fabric-price__base { color: var(--fabric-ink); font-size: .87rem; font-weight: 800; }
    #fabric-sale-{{ section.id }} .fabric-price__base span { color: var(--fabric-muted); font-size: .62rem; font-weight: 600; }
    #fabric-sale-{{ section.id }} .fabric-price__metre { display: block; margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--fabric-line); color: var(--fabric-pink); font-size: .68rem; font-weight: 850; }
    #fabric-sale-{{ section.id }} .fabric-price__metre small { display: block; margin-top: 2px; color: var(--fabric-muted); font-size: .57rem; font-weight: 700; }
    #fabric-sale-{{ section.id }} .fabric-card__button { width: 100%; min-height: 35px; margin-top: auto; border: 1px solid var(--fabric-pink); border-radius: 6px; color: #fff; background: var(--fabric-pink); cursor: pointer; font-size: .6rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; transition: color .25s, background .25s, transform .25s; }
    #fabric-sale-{{ section.id }} .fabric-card__button:hover { color: var(--fabric-pink); background: #fff; }
    #fabric-sale-{{ section.id }} .fabric-card__button:disabled { opacity: .45; cursor: not-allowed; }
    #fabric-sale-{{ section.id }} .fabric-loader { display: flex; justify-content: center; padding: 32px 0 0; color: var(--fabric-muted); font-size: .82rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
    #fabric-sale-{{ section.id }} .fabric-loader[hidden] { display: none; }
    #fabric-sale-{{ section.id }} .fabric-empty { padding: 68px 18px; color: var(--fabric-muted); text-align: center; }

    /* Popup */
    #fabric-sale-{{ section.id }} .fabric-popup { width: min(386px, calc(100% - 28px)); padding: 0; border: 0; background: transparent; color: #fff; }
    #fabric-sale-{{ section.id }} .fabric-popup::backdrop { background: rgba(25, 5, 16, .72); backdrop-filter: blur(8px); }
    #fabric-sale-{{ section.id }} .fabric-popup__card { position: relative; overflow: hidden; padding: 21px; border: 1px solid rgba(255, 205, 231, .37); border-radius: 12px; background: linear-gradient(155deg, #42152d 0%, #170812 72%); box-shadow: 0 32px 80px -24px rgba(0,0,0,.72); }
    #fabric-sale-{{ section.id }} .fabric-popup__card::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, #ffc4df, var(--fabric-pink), #ffc4df); }
    #fabric-sale-{{ section.id }} .fabric-popup__close { position: absolute; right: 12px; top: 12px; width: 31px; height: 31px; border: 0; border-radius: 50%; color: #fff; background: rgba(0,0,0,.32); cursor: pointer; font-size: 1.2rem; line-height: 1; }
    #fabric-sale-{{ section.id }} .fabric-popup h2 { max-width: 16ch; margin: 0 35px 8px 0; color: #ffe2f0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.45rem, 6vw, 1.85rem); font-weight: 400; line-height: .98; letter-spacing: -.045em; text-transform: uppercase; }
    #fabric-sale-{{ section.id }} .fabric-popup__text { margin: 0 0 13px; color: #e4bdcf; font-size: .78rem; line-height: 1.45; }
    #fabric-sale-{{ section.id }} .fabric-field { display: block; margin: 9px 0; }
    #fabric-sale-{{ section.id }} .fabric-field span { display: block; margin: 0 0 5px; color: #f2c8dc; font-size: .57rem; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
    #fabric-sale-{{ section.id }} .fabric-field input { width: 100%; min-height: 41px; padding: 0 11px; border: 1px solid rgba(255,203,231,.3); border-radius: 6px; outline: 0; color: #fff; background: rgba(0,0,0,.2); font-size: .82rem; }
    #fabric-sale-{{ section.id }} .fabric-field input:focus { border-color: #ffc8e3; }
    #fabric-sale-{{ section.id }} .fabric-consent { display: flex; gap: 8px; align-items: flex-start; margin: 10px 0; color: #e7c1d4; font-size: .62rem; line-height: 1.4; }
    #fabric-sale-{{ section.id }} .fabric-consent input { width: 14px; height: 14px; margin: 1px 0 0; accent-color: var(--fabric-pink); }
    #fabric-sale-{{ section.id }} .fabric-popup__submit { width: 100%; min-height: 40px; border: 0; border-radius: 999px; color: #fff; background: var(--fabric-pink); cursor: pointer; font-size: .65rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
    #fabric-sale-{{ section.id }} .fabric-popup__skip { display: block; width: max-content; margin: 9px auto 0; border: 0; color: #f3cbdf; background: none; cursor: pointer; font-size: .7rem; text-decoration: underline; text-underline-offset: 3px; }
    #fabric-sale-{{ section.id }} .fabric-form-error { margin: 9px 0 0; color: #ffb8d9; font-size: .76rem; }
    #fabric-sale-{{ section.id }} .fabric-popup__success { text-align: center; }
    #fabric-sale-{{ section.id }} .fabric-popup__success h2 { margin-inline: auto; }

    @media (max-width: 1150px) { #fabric-sale-{{ section.id }} .fabric-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @media (max-width: 720px) {
      #fabric-sale-{{ section.id }} { --fabric-wrap: min(100% - 26px, 1360px); }
      #fabric-sale-{{ section.id }} .fabric-hero { min-height: 560px; }
      #fabric-sale-{{ section.id }} .fabric-hero__image::after { background: linear-gradient(90deg, rgba(35,19,28,.9), rgba(35,19,28,.4)); }
      #fabric-sale-{{ section.id }} .fabric-countdown__inner { padding: 19px 0; align-items: flex-start; flex-direction: column; gap: 16px; }
      #fabric-sale-{{ section.id }} .fabric-clock { width: 100%; justify-content: space-between; }
      #fabric-sale-{{ section.id }} .fabric-clock__unit { min-width: 0; flex: 1; padding: 0 5px; }
      #fabric-sale-{{ section.id }} .fabric-products__head { align-items: flex-start; flex-direction: column; margin-bottom: 26px; }
      #fabric-sale-{{ section.id }} .fabric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }
      #fabric-sale-{{ section.id }} .fabric-card { border-radius: 8px; }
      #fabric-sale-{{ section.id }} .fabric-card__body { min-height: 150px; padding: 9px; }
      #fabric-sale-{{ section.id }} .fabric-card__title { font-size: .89rem; }
      #fabric-sale-{{ section.id }} .fabric-price { margin-top: 8px; }
      #fabric-sale-{{ section.id }} .fabric-popup__card { padding: 21px; }
    }
  </style>

  {%- if false -%}
  <div class="fabric-hero">
    {%- if section.settings.banner_image != blank -%}
      <div class="fabric-hero__image">{{ section.settings.banner_image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,1800,2200', sizes: '100vw', alt: section.settings.banner_image.alt | default: section.settings.heading }}</div>
    {%- endif -%}
    <div class="fabric-hero__content">
      <div class="fabric-hero__copy">
        <span class="fabric-eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.subheading }}</p>
        <span class="fabric-hero__offer">{{ section.settings.offer_text }}</span>
      </div>
    </div>
  </div>
  {%- endif -%}

  <div class="fabric-countdown" aria-label="Today's offer countdown">
    <div class="fabric-countdown__inner">
      <div class="fabric-countdown__intro">Daily fabric edit<strong>{{ section.settings.timer_text }}</strong></div>
      <div class="fabric-clock" data-daily-clock role="timer" aria-live="off">
        <div class="fabric-clock__unit"><b data-clock="h">00</b><span>Hours</span></div>
        <div class="fabric-clock__unit"><b data-clock="m">00</b><span>Minutes</span></div>
        <div class="fabric-clock__unit"><b data-clock="s">00</b><span>Seconds</span></div>
      </div>
    </div>
  </div>

  <div class="fabric-products" id="fabric-products-{{ section.id }}">
    <div class="fabric-wrap">
      <div class="fabric-products__head">
        <div>
          <span class="fabric-eyebrow" style="color:var(--fabric-pink)">Selected collection</span>
          <h2>{{ section.settings.products_heading }}</h2>
        </div>
        <p>{{ section.settings.products_subheading }}</p>
      </div>

      {%- if fabric_collection != blank -%}
        <div class="fabric-grid" data-fabric-grid>
          {%- for product in fabric_collection.products limit: initial_count -%}
            {%- liquid
              assign fabric_meter_price = product.price | times: units_per_metre
              assign fabric_variant = product.selected_or_first_available_variant
              assign fabric_product_tags = product.tags | join: '|' | downcase
            -%}
            <article class="fabric-card" data-product-id="{{ product.id }}">
              <a class="fabric-card__media" href="{{ product.url }}">
                {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '260,360,480,640,800', sizes: '(min-width: 1000px) 25vw, (min-width: 720px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title }}{%- endif -%}
                <span class="fabric-card__badge">{{ section.settings.offer_text }}</span>
              </a>
              <div class="fabric-card__body">
                <h3 class="fabric-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <div class="fabric-price">
                  <div class="fabric-price__base">{{ product.price | money }}{% if fabric_product_tags contains 'decimal' %} <span>/ {{ section.settings.single_quantity_label }}</span>{% endif %}</div>
                  {%- if fabric_product_tags contains 'decimal' -%}
                    <div class="fabric-price__metre"><span>{{ fabric_meter_price | money }} / {{ section.settings.metre_label }}</span><small>{{ units_per_metre }} qty = 1 {{ section.settings.metre_label }}</small></div>
                  {%- endif -%}
                </div>
                {%- if product.available and product.has_only_default_variant -%}
                  <button class="fabric-card__button" type="button" data-add-to-cart="{{ fabric_variant.id }}">Add to cart</button>
                {%- elsif product.available -%}
                  <a class="fabric-card__button" style="display:grid;place-items:center;text-decoration:none" href="{{ product.url }}">Choose options</a>
                {%- else -%}
                  <button class="fabric-card__button" type="button" disabled>Sold out</button>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
        <div class="fabric-loader" data-fabric-loader hidden>Loading more fabrics…</div>
        <div data-fabric-sentinel aria-hidden="true"></div>
      {%- else -%}
        <div class="fabric-empty">Select a collection in this section’s settings to display its products.</div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_popup -%}
    {%- form 'customer', id: 'fabric-signup' -%}
      {%- liquid
        assign fabric_popup_state = ''
        if form.posted_successfully?
          assign fabric_popup_state = 'success'
        elsif form.errors
          assign fabric_email_error = form.errors.messages['email'] | downcase
          if fabric_email_error contains 'taken' or fabric_email_error contains 'already' or fabric_email_error contains 'exist'
            assign fabric_popup_state = 'success'
          else
            assign fabric_popup_state = 'error'
          endif
        endif
      -%}
      <dialog class="fabric-popup" data-fabric-popup data-form-state="{{ fabric_popup_state }}" aria-labelledby="fabric-popup-title-{{ section.id }}">
        <div class="fabric-popup__card">
          <button class="fabric-popup__close" type="button" data-popup-close aria-label="Close">×</button>
          {%- if fabric_popup_state == 'success' -%}
            <div class="fabric-popup__success">
              <h2 id="fabric-popup-title-{{ section.id }}">You’re on the list</h2>
              <p class="fabric-popup__text">Your exclusive fabric offers are ready. Happy shopping.</p>
              <button class="fabric-popup__submit" type="button" data-popup-close>Start shopping</button>
            </div>
          {%- else -%}
            <h2 id="fabric-popup-title-{{ section.id }}">{{ section.settings.popup_heading }}</h2>
            <p class="fabric-popup__text">{{ section.settings.popup_text }}</p>
            <input type="hidden" name="contact[tags]" value="black-friday-2026,newsletter">
            <input type="hidden" name="contact[accepts_marketing]" value="true">
            <input type="hidden" name="contact[first_name]" data-popup-first>
            <input type="hidden" name="contact[last_name]" data-popup-last>
            <label class="fabric-field"><span>Full name</span><input type="text" required autocomplete="name" placeholder="Your full name" data-popup-name></label>
            <label class="fabric-field"><span>Email address</span><input type="email" required autocomplete="email" name="contact[email]" placeholder="you@example.com" data-popup-email></label>
            <label class="fabric-consent"><input type="checkbox" required data-popup-consent><span>I agree to receive marketing emails and accept the {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener">privacy policy</a>{% else %}privacy policy{% endif %}.</span></label>
            {%- if fabric_popup_state == 'error' -%}<div class="fabric-form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
            <button class="fabric-popup__submit" type="submit">Continue shopping</button>
            <button class="fabric-popup__skip" type="button" data-popup-close>Browse without joining</button>
          {%- endif -%}
        </div>
      </dialog>
    {%- endform -%}
  {%- endif -%}

  <script>
    (() => {
      const root = document.getElementById('fabric-sale-{{ section.id }}');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = 'true';
      const $ = (selector, scope = root) => scope.querySelector(selector);
      const esc = (value) => String(value == null ? '' : value).replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
      const moneyFormat = root.dataset.moneyFormat || '{% raw %}${{amount}}{% endraw %}';
      const money = cents => moneyFormat.replace(/\{\{\s*(amount_no_decimals|amount|amount_with_comma_separator)\s*\}\}/, (match, type) => {
        const value = Number(cents || 0) / 100;
        if (type === 'amount_no_decimals') return Math.round(value).toLocaleString();
        return value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      });

      /* Resets at the next local midnight, so the promotion refreshes every 24 hours. */
      const clock = $('[data-daily-clock]');
      function updateClock() {
        if (!clock) return;
        const now = new Date();
        const next = new Date(now);
        next.setHours(24, 0, 0, 0);
        const seconds = Math.max(0, Math.floor((next - now) / 1000));
        const values = { h: Math.floor(seconds / 3600), m: Math.floor(seconds % 3600 / 60), s: seconds % 60 };
        Object.keys(values).forEach(key => { const cell = $('[data-clock="' + key + '"]', clock); if (cell) cell.textContent = String(values[key]).padStart(2, '0'); });
      }
      updateClock(); setInterval(updateClock, 1000);

      const grid = $('[data-fabric-grid]');
      const loader = $('[data-fabric-loader]');
      const sentinel = $('[data-fabric-sentinel]');
      const productsUrl = root.dataset.productsUrl;
      const initialCount = Number(root.dataset.initialCount || 12);
      const batchSize = Number(root.dataset.batchSize || 12);
      const unitsPerMetre = Math.max(1, Number(root.dataset.unitsPerMetre || 2));
      const metreLabel = root.dataset.metreLabel || 'metre';
      let allProducts = null, nextIndex = initialCount, loading = false, observer;
      function card(product) {
        const price = Number(product.price || 0);
        const tags = Array.isArray(product.tags) ? product.tags.join('|').toLowerCase() : String(product.tags || '').toLowerCase();
        const quantityLabel = tags.includes('decimal') ? ' <span>/ {{ section.settings.single_quantity_label | escape }}</span>' : '';
        const metrePrice = tags.includes('decimal') ? '<div class="fabric-price__metre"><span>' + money(price * unitsPerMetre) + ' / ' + esc(metreLabel) + '</span><small>' + unitsPerMetre + ' qty = 1 ' + esc(metreLabel) + '</small></div>' : '';
        const variant = (product.variants || []).find(item => item.available) || (product.variants || [])[0];
        const image = (product.images && product.images[0] && (product.images[0].src || product.images[0])) || product.featured_image || '';
        const url = product.url || ('/products/' + product.handle);
        const action = !product.available ? '<button class="fabric-card__button" disabled>Sold out</button>' : (product.variants || []).length > 1 ? '<a class="fabric-card__button" style="display:grid;place-items:center;text-decoration:none" href="' + esc(url) + '">Choose options</a>' : '<button class="fabric-card__button" type="button" data-add-to-cart="' + esc(variant && variant.id) + '">Add to cart</button>';
        return '<article class="fabric-card" data-product-id="' + esc(product.id) + '"><a class="fabric-card__media" href="' + esc(url) + '">' + (image ? '<img loading="lazy" src="' + esc(image) + '" alt="' + esc(product.title) + '">' : '') + '<span class="fabric-card__badge">{{ section.settings.offer_text | escape }}</span></a><div class="fabric-card__body"><h3 class="fabric-card__title"><a href="' + esc(url) + '">' + esc(product.title) + '</a></h3><div class="fabric-price"><div class="fabric-price__base">' + money(price) + quantityLabel + '</div>' + metrePrice + '</div>' + action + '</div></article>';
      }
      async function loadProducts() {
        if (!grid || loading || allProducts) return;
        loading = true; if (loader) loader.hidden = false;
        try { const response = await fetch(productsUrl, { headers: { Accept: 'application/json' } }); if (!response.ok) throw new Error(); const data = await response.json(); allProducts = data.products || []; }
        catch (error) { allProducts = []; if (sentinel) sentinel.remove(); }
        finally { loading = false; if (loader) loader.hidden = true; appendBatch(); }
      }
      function appendBatch() {
        if (!grid || !allProducts || loading) return;
        const batch = allProducts.slice(nextIndex, nextIndex + batchSize);
        if (batch.length) { grid.insertAdjacentHTML('beforeend', batch.map(card).join('')); nextIndex += batch.length; }
        if (nextIndex >= allProducts.length && sentinel) { sentinel.remove(); if (observer) observer.disconnect(); }
      }
      if (grid && sentinel && productsUrl) {
        observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) allProducts ? appendBatch() : loadProducts(); }, { rootMargin: '500px 0px' });
        observer.observe(sentinel);
      }

      root.addEventListener('click', async event => {
        const add = event.target.closest('[data-add-to-cart]');
        if (!add) return;
        const id = Number(add.dataset.addToCart); if (!id) return;
        const original = add.textContent; add.disabled = true; add.textContent = 'Adding…';
        try { const response = await fetch('{{ routes.cart_add_url }}.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id, quantity: 1 }] }) }); if (!response.ok) throw new Error(); add.textContent = 'Added ✓'; }
        catch (error) { add.textContent = 'Try again'; }
        setTimeout(() => { add.disabled = false; add.textContent = original; }, 1400);
      });

      const popup = $('[data-fabric-popup]');
      const popupKey = 'fabric-bf-subscriber-v1';
      const seenKey = 'fabric-bf-popup-seen-v1';
      const setCookie = () => { document.cookie = popupKey + '=1; path=/; max-age=' + (60 * 60 * 24 * 365) + '; SameSite=Lax'; };
      const hasCookie = document.cookie.split('; ').some(value => value.indexOf(popupKey + '=1') === 0);
      if (popup) {
        if (popup.dataset.formState === 'success') { setCookie(); sessionStorage.setItem(seenKey, '1'); }
        else if (!hasCookie && !sessionStorage.getItem(seenKey)) { setTimeout(() => popup.showModal(), 450); }
        $('[data-popup-close]', popup)?.addEventListener('click', () => { sessionStorage.setItem(seenKey, '1'); popup.close(); });
        popup.addEventListener('click', event => { if (event.target === popup) { sessionStorage.setItem(seenKey, '1'); popup.close(); } });
        const form = popup.closest('form');
        form?.addEventListener('submit', event => {
          const name = $('[data-popup-name]', popup), email = $('[data-popup-email]', popup), consent = $('[data-popup-consent]', popup);
          if (!name || !email || !consent || !name.value.trim() || !email.validity.valid || !consent.checked) { event.preventDefault(); (name && !name.value.trim() ? name : !email.validity.valid ? email : consent).focus(); return; }
          const pieces = name.value.trim().replace(/\s+/g, ' ').split(' '); $('[data-popup-first]', popup).value = pieces.shift(); $('[data-popup-last]', popup).value = pieces.join(' ');
        });
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "Fabric sale landing",
  "tag": "section",
  "class": "fabric-sale-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "header", "content": "Collection" },
    { "type": "collection", "id": "collection", "label": "Collection to display", "info": "Only products from this collection are shown and loaded as visitors scroll." },
    { "type": "range", "id": "initial_products", "label": "Products on initial load", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "range", "id": "products_per_load", "label": "Products per scroll load", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "header", "content": "Banner" },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fabric festival · limited edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fabric that makes every look feel special." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover premium fabrics, rich textures and vibrant prints selected for your next creation." },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "Flat 25% off" },
    { "type": "color", "id": "primary_color", "label": "Primary colour", "default": "#ce1178" },
    { "type": "header", "content": "Daily timer" },
    { "type": "text", "id": "timer_text", "label": "Timer heading", "default": "Today’s flat 25% off ends in" },
    { "type": "header", "content": "Product pricing" },
    { "type": "range", "id": "units_per_metre", "label": "Quantity equal to one metre", "min": 1, "max": 20, "step": 1, "default": 2, "info": "Use 2 when two quantities equal one metre." },
    { "type": "text", "id": "single_quantity_label", "label": "Single quantity label", "default": "0.5 metre" },
    { "type": "text", "id": "metre_label", "label": "Metre label", "default": "metre" },
    { "type": "header", "content": "Product grid" },
    { "type": "text", "id": "products_heading", "label": "Heading", "default": "Shop the fabric edit" },
    { "type": "textarea", "id": "products_subheading", "label": "Subheading", "default": "Scroll to explore more styles. New product cards load automatically as you browse." },
    { "type": "header", "content": "Email popup" },
    { "type": "checkbox", "id": "show_popup", "label": "Show signup popup", "default": true },
    { "type": "text", "id": "popup_heading", "label": "Heading", "default": "Unlock exclusive fabric deals" },
    { "type": "textarea", "id": "popup_text", "label": "Text", "default": "Join our shopping list for early access and subscriber-only offers." }
  ],
  "presets": [{ "name": "Fabric sale landing" }]
}
{% endschema %}
