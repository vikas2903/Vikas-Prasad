      let bad = null;
      if (name.length < 2) { setErr(nameIn, 'bf-pop-name-err', 'Enter your full name.'); bad = bad || nameIn; } else setErr(nameIn, 'bf-pop-name-err', '');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { setErr(emailIn, 'bf-pop-email-err', 'Enter a valid email address, like name@example.com.'); bad = bad || emailIn; } else setErr(emailIn, 'bf-pop-email-err', '');
      if (!consent.checked) { $('#bf-pop-consent-err').textContent = 'Tick the box to agree before continuing.'; bad = bad || consent; } else $('#bf-pop-consent-err').textContent = '';
      if (bad) { e.preventDefault(); bad.focus(); return; }
      const parts = name.split(' ');
      $('[data-first]', pop).value = parts.shift();
      $('[data-last]', pop).value = parts.join(' ');
      emailIn.value = email;
      form.querySelector('[type="submit"]').classList.add('is-busy');
    });
  }

  /* Newsletter + footer forms: remember the session after a successful post */
  if (/customer_posted=true/.test(location.search)) setCookie('bf_member', '1', CFG.memberDays);

  /* ---------- Keep cart count in sync (incl. back/forward cache) ---------- */
  getCart().then(updateSaleOffers).catch(() => {});
  addEventListener('pageshow', (e) => { if (e.persisted) getCart().then((c) => { setCount(c.item_count); updateSaleOffers(c); }).catch(() => {}); });
})();
</script>
</div>

