          <span class="bf-offer__status" data-offer-status>Checking your cart…</span>
        </article>
      {%- endif -%}
      {%- if section.settings.offer_20off_enabled -%}
        <article class="bf-offer" data-sale-offer data-required="{{ section.settings.offer_20off_required }}" data-offer-name="{{ section.settings.offer_20off_title | escape }}" data-offer-suffix="{{ section.settings.offer_20off_suffix | escape }}" data-reveal>
          <span class="bf-offer__eyebrow">Black Friday special</span>
          <h3>{{ section.settings.offer_20off_title }}</h3>
          <p>{{ section.settings.offer_20off_description }}</p>
          <span class="bf-offer__status" data-offer-status>Checking your cart…</span>
        </article>
      {%- endif -%}
    </div>
    <p class="bf-offers__note">{{ section.settings.sale_offers_note }}</p>
  </div>
</section>
{%- endif -%}

{%- comment -%} ===================== A. EXCLUSIVE DEALS ===================== {%- endcomment -%}
{%- if deals_col != blank and deals_col.products_count > 0 -%}
<section class="bf-section" id="deals" aria-labelledby="bf-deals-title">
  <div class="bf-wrap">
    <div class="bf-sechead" data-reveal>
      <div>
        <h2 class="bf-h2" id="bf-deals-title">{{ section.settings.deals_heading }}</h2>
        <p class="bf-lede">{{ section.settings.deals_sub }}</p>
      </div>
      <div class="bf-carousel__nav">
        <button type="button" class="bf-round" data-car-prev aria-label="Previous deals"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="bf-round" data-car-next aria-label="Next deals"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
    </div>
    <div class="bf-carousel" data-carousel>
      <div class="bf-carousel__track" data-car-track data-sort-pct tabindex="0" aria-label="Biggest discounts">
        {%- for product in deals_col.products limit: 16 -%}
          {%- liquid
            assign bf_pct = 0
            if product.compare_at_price > product.price
              assign bf_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
            endif
            assign bf_tags = product.tags | join: '|' | downcase
          -%}
          <article class="bf-card{% unless product.available %} is-soldout{% endunless %}" data-card data-handle="{{ product.handle }}" data-type="{{ product.type | escape }}" data-price="{{ product.price }}" data-available="{{ product.available }}" data-pct="{{ bf_pct }}">
            <div class="bf-card__media">
              <a href="{{ product.url }}" class="bf-card__link" data-quickview="{{ product.handle }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,750,900', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 72vw', alt: product.featured_image.alt | default: product.title, class: 'bf-card__img' }}
                  {%- if product.images.size > 1 -%}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,750,900', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 72vw', alt: '', class: 'bf-card__img bf-card__img--alt' }}{%- endif -%}
                {%- else -%}<span class="bf-card__noimg">{{ product.title }}</span>{%- endif -%}
              </a>
              {%- if bf_tags contains 'bestseller' or bf_tags contains 'best seller' -%}<span class="bf-badge">Bestseller</span>{%- elsif bf_tags contains 'limited' -%}<span class="bf-badge">Limited offer</span>{%- elsif bf_pct > 0 -%}<span class="bf-badge">Black Friday deal</span>{%- endif -%}
              {%- if bf_pct > 0 -%}<span class="bf-pct" aria-label="{{ bf_pct }} percent off">−{{ bf_pct }}%</span>{%- endif -%}
              <button type="button" class="bf-card__qv" data-quickview="{{ product.handle }}">Quick view<span class="bf-sr"> {{ product.title }}</span></button>
            </div>
            <div class="bf-card__body"><h3 class="bf-card__title"><a href="{{ product.url }}" data-quickview="{{ product.handle }}">{{ product.title }}</a></h3><p class="bf-price"><span class="bf-price__now">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>{% if bf_pct > 0 %}<s class="bf-price__was">{{ product.compare_at_price | money }}</s>{% endif %}</p>{% if product.available %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" {% if product.has_only_default_variant %}data-add="{{ product.first_available_variant.id }}"{% else %}data-quickview="{{ product.handle }}"{% endif %}>{% if product.has_only_default_variant %}Add to cart{% else %}Choose options{% endif %}</button>{% else %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" disabled>Sold out</button>{% endif %}</div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{%- endif -%}
{%- comment -%} ===================== MAIN PRODUCT GRID ===================== {%- endcomment -%}
<section class="bf-section" id="shop" aria-labelledby="bf-shop-title">
  <div class="bf-wrap">
    <div class="bf-sechead" data-reveal>
      <div>
        <h2 class="bf-h2" id="bf-shop-title">{{ section.settings.shop_heading }}</h2>
        <p class="bf-lede">{{ section.settings.shop_sub }}</p>
      </div>
      {%- if main_col != blank -%}<a class="bf-textlink" href="{{ main_col.url }}">View the selected collection</a>{%- endif -%}
    </div>

    <div class="bf-filters" role="group" aria-label="Filter products">
      <div class="bf-pills" role="toolbar" aria-label="Category">
        <button type="button" class="bf-pill" data-filter-type="all" aria-pressed="true">All</button>
        {%- for t in types -%}
          {%- if t != blank -%}
            <button type="button" class="bf-pill" data-filter-type="{{ t | escape }}" aria-pressed="false">{{ t }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="bf-filters__right">
        {%- assign breaks = section.settings.price_breaks | split: ',' -%}
        <label class="bf-sr" for="bf-price">Price</label>
        <select class="bf-select" id="bf-price" data-filter-price>
          <option value="all">Any price</option>
          {%- for b in breaks -%}
            {%- assign bi = b | strip | plus: 0 -%}
            {%- if forloop.first -%}
              <option value="0-{{ bi }}">Under {{ bi | times: 100 | money_without_trailing_zeros }}</option>
            {%- endif -%}
            {%- unless forloop.last -%}
              {%- assign nx = breaks[forloop.index] | strip | plus: 0 -%}
              <option value="{{ bi }}-{{ nx }}">{{ bi | times: 100 | money_without_trailing_zeros }} to {{ nx | times: 100 | money_without_trailing_zeros }}</option>
            {%- endunless -%}
            {%- if forloop.last -%}
              <option value="{{ bi }}-999999999">Over {{ bi | times: 100 | money_without_trailing_zeros }}</option>
            {%- endif -%}
          {%- endfor -%}
        </select>
        <label class="bf-sr" for="bf-sort">Sort by</label>
        <select class="bf-select" id="bf-sort" data-sort>
          <option value="featured">Featured</option>
          <option value="discount">Biggest discount</option>
          <option value="price-asc">Price, low to high</option>
          <option value="price-desc">Price, high to low</option>
        </select>
        <label class="bf-toggle"><input type="checkbox" data-filter-stock> In stock</label>
        <span class="bf-count-result" data-result-count aria-live="polite"></span>
      </div>
    </div>

    <div class="bf-grid" data-grid>
      {%- for product in main_col.products limit: 48 -%}
        {%- liquid
          assign bf_pct = 0
          if product.compare_at_price > product.price
            assign bf_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
          endif
          assign bf_tags = product.tags | join: '|' | downcase
          assign bf_metre_price = product.price | times: section.settings.units_per_metre
          assign bf_loading = 'lazy'
          if forloop.index <= 4
            assign bf_loading = 'eager'
          endif
        -%}
        <article class="bf-card{% unless product.available %} is-soldout{% endunless %}" data-card data-handle="{{ product.handle }}" data-type="{{ product.type | escape }}" data-price="{{ product.price }}" data-available="{{ product.available }}" data-pct="{{ bf_pct }}">
          <div class="bf-card__media"><a href="{{ product.url }}" class="bf-card__link" data-quickview="{{ product.handle }}" tabindex="-1" aria-hidden="true">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: bf_loading, widths: '300,450,600,750,900', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title, class: 'bf-card__img' }}{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,750,900', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw', alt: '', class: 'bf-card__img bf-card__img--alt' }}{% endif %}{% else %}<span class="bf-card__noimg">{{ product.title }}</span>{% endif %}</a>{% if bf_tags contains 'bestseller' or bf_tags contains 'best seller' %}<span class="bf-badge">Bestseller</span>{% elsif bf_tags contains 'limited' %}<span class="bf-badge">Limited offer</span>{% elsif bf_pct > 0 %}<span class="bf-badge">Black Friday deal</span>{% endif %}{% if bf_pct > 0 %}<span class="bf-pct" aria-label="{{ bf_pct }} percent off">−{{ bf_pct }}%</span>{% endif %}<button type="button" class="bf-card__qv" data-quickview="{{ product.handle }}">Quick view<span class="bf-sr"> {{ product.title }}</span></button></div>
          <div class="bf-card__body"><h3 class="bf-card__title"><a href="{{ product.url }}" data-quickview="{{ product.handle }}">{{ product.title }}</a></h3><p class="bf-price"><span class="bf-price__now">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>{% if bf_pct > 0 %}<s class="bf-price__was">{{ product.compare_at_price | money }}</s>{% endif %}</p>{% if section.settings.show_metre_price %}<p class="bf-meter-price"><strong>{{ bf_metre_price | money }}</strong> per {{ section.settings.metre_label }} <span>({{ section.settings.units_per_metre }} qty)</span></p>{% endif %}{% if product.available %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" {% if product.has_only_default_variant %}data-add="{{ product.first_available_variant.id }}"{% else %}data-quickview="{{ product.handle }}"{% endif %}>{% if product.has_only_default_variant %}Add to cart{% else %}Choose options{% endif %}</button>{% else %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" disabled>Sold out</button>{% endif %}</div>
        </article>
      {%- else -%}
        <p class="bf-empty">Select a collection in this section’s settings to show its products here.</p>
      {%- endfor -%}
    </div>
    <div class="bf-empty" data-grid-empty hidden>
      <p>No products match these filters.</p>
      <button type="button" class="bf-btn bf-btn--ghost" data-filter-reset>Clear filters</button>
    </div>
  </div>
</section>

{%- if false -%}
{%- comment -%} ===================== B. BEST SELLERS ===================== {%- endcomment -%}
{%- if best_col != blank and best_col.products_count > 0 -%}
<section class="bf-section" id="bestsellers" aria-labelledby="bf-best-title">
