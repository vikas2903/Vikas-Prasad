          endif
        -%}
        <article class="bf-card{% unless product.available %} is-soldout{% endunless %}" data-card data-handle="{{ product.handle }}" data-type="{{ product.type | escape }}" data-price="{{ product.price }}" data-available="{{ product.available }}" data-pct="{{ bf_pct }}"><div class="bf-card__media"><a href="{{ product.url }}" class="bf-card__link" data-quickview="{{ product.handle }}" tabindex="-1" aria-hidden="true">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,750,900', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title, class: 'bf-card__img' }}{% else %}<span class="bf-card__noimg">{{ product.title }}</span>{% endif %}</a><span class="bf-badge">Limited offer</span>{% if bf_pct > 0 %}<span class="bf-pct" aria-label="{{ bf_pct }} percent off">−{{ bf_pct }}%</span>{% endif %}<button type="button" class="bf-card__qv" data-quickview="{{ product.handle }}">Quick view<span class="bf-sr"> {{ product.title }}</span></button></div><div class="bf-card__body"><h3 class="bf-card__title"><a href="{{ product.url }}" data-quickview="{{ product.handle }}">{{ product.title }}</a></h3><p class="bf-price"><span class="bf-price__now">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>{% if bf_pct > 0 %}<s class="bf-price__was">{{ product.compare_at_price | money }}</s>{% endif %}</p>{% if l_end != blank %}<div class="bf-minicount" data-countdown="{{ l_end }}" data-compact><span class="bf-minicount__label">Offer ends in</span><span class="bf-minicount__time"><span data-unit="d">00</span>d <span data-unit="h">00</span>h <span data-unit="m">00</span>m <span data-unit="s">00</span>s</span></div>{% endif %}{% if product.available %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" {% if product.has_only_default_variant %}data-add="{{ product.first_available_variant.id }}"{% else %}data-quickview="{{ product.handle }}"{% endif %}>{% if product.has_only_default_variant %}Add to cart{% else %}Choose options{% endif %}</button>{% else %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" disabled>Sold out</button>{% endif %}</div></article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ===================== D. WHY SHOP WITH US ===================== {%- endcomment -%}
{%- if perks.size > 0 -%}
<section class="bf-section" id="why" aria-labelledby="bf-why-title">
  <div class="bf-wrap">
    <div class="bf-sechead" data-reveal>
      <h2 class="bf-h2" id="bf-why-title">{{ section.settings.why_heading }}</h2>
    </div>
    <div class="bf-perks" data-reveal>
      {%- for block in perks -%}
        <div class="bf-perk" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- when 'gem' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M6 4h12l3 5-9 11L3 9z"/><path d="M3 9h18M9 4l3 16 3-16"/></svg>
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
            {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5L4 9l4 4"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg>
          {%- endcase -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ===================== E. SOCIAL PROOF ===================== {%- endcomment -%}
{%- if reviews.size > 0 -%}
<section class="bf-section" id="reviews" aria-labelledby="bf-rev-title">
  <div class="bf-wrap">
    <div class="bf-sechead" data-reveal>
      <h2 class="bf-h2" id="bf-rev-title">{{ section.settings.reviews_heading }}</h2>
    </div>
    <div class="bf-reviews">
      {%- for block in reviews -%}
        <figure class="bf-review" data-reveal {{ block.shopify_attributes }}>
          {%- assign fill = block.settings.rating | times: 20 -%}
          <span class="bf-stars" style="--fill: {{ fill }}%" role="img" aria-label="Rated {{ block.settings.rating }} out of 5"></span>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption><strong>{{ block.settings.author }}</strong>{{ block.settings.detail }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ===================== F. FAQ ===================== {%- endcomment -%}
{%- if faqs.size > 0 -%}
<section class="bf-section" id="faq" aria-labelledby="bf-faq-title">
  <div class="bf-wrap bf-faq">
    <div class="bf-faq__head">
      <h2 class="bf-h2" id="bf-faq-title">{{ section.settings.faq_heading }}</h2>
      <p class="bf-lede">Still unsure? <a class="bf-textlink" href="{{ section.settings.contact_url | default: '/pages/contact' }}">Contact us</a></p>
    </div>
    <div>
      {%- for block in faqs -%}
        <details class="bf-acc" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="bf-acc__icon" aria-hidden="true"></span></summary>
          <div class="bf-acc__body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ===================== G. FINAL BANNER ===================== {%- endcomment -%}
<section class="bf-final" aria-labelledby="bf-final-title">
  <div class="bf-wrap">
    <h2 class="bf-final__title" id="bf-final-title" data-reveal>{{ section.settings.final_heading }}</h2>
    <p data-reveal>{{ section.settings.final_sub }}</p>
    {%- if end_at != blank -%}
      <div class="bf-count" data-countdown="{{ end_at }}" role="timer" aria-label="Time left in the sale">
        <div class="bf-count__cell"><span class="bf-count__num" data-unit="d">00</span><span class="bf-count__lbl">days</span></div>
        <div class="bf-count__cell"><span class="bf-count__num" data-unit="h">00</span><span class="bf-count__lbl">hours</span></div>
        <div class="bf-count__cell"><span class="bf-count__num" data-unit="m">00</span><span class="bf-count__lbl">minutes</span></div>
        <div class="bf-count__cell"><span class="bf-count__num" data-unit="s">00</span><span class="bf-count__lbl">seconds</span></div>
      </div>
    {%- endif -%}
    <a href="#{% if deals_col != blank %}deals{% else %}shop{% endif %}" class="bf-btn bf-btn--gold">Shop Black Friday deals</a>
  </div>
</section>

{%- comment -%} ===================== H. NEWSLETTER ===================== {%- endcomment -%}
<section class="bf-section" id="newsletter" aria-labelledby="bf-news-title">
  <div class="bf-wrap bf-news">
    <div data-reveal>
      <h2 class="bf-h2" id="bf-news-title">{{ section.settings.news_heading }}</h2>
      <p class="bf-lede">{{ section.settings.news_sub }}</p>
    </div>
    <div data-reveal>
      {%- form 'customer', id: 'bf-news-form', class: 'bf-news-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.subscriber_tag }},newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <div class="bf-inline-form">
          <label class="bf-sr" for="bf-news-email">Email address</label>
          <input class="bf-input" type="email" id="bf-news-email" name="contact[email]" placeholder="Your email address" autocomplete="email" required>
          <button type="submit" class="bf-btn bf-btn--gold">Subscribe</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="bf-form-msg bf-form-msg--ok" role="status">You’re on the list. Watch your inbox for subscriber offers.</p>
        {%- elsif form.errors -%}
          <div class="bf-form-msg bf-form-msg--err" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <p class="bf-fine">You can unsubscribe at any time. See our {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">privacy policy</a>{% else %}privacy policy{% endif %}.</p>
      {%- endform -%}
    </div>
  </div>
</section>

</main>

{%- comment -%} ===================== FOOTER ===================== {%- endcomment -%}
{%- if section.settings.show_section_footer -%}
<footer class="bf-foot">
  <div class="bf-wrap">
    <div class="bf-foot__grid">
      <div>
        <a href="{{ routes.root_url }}" class="bf-logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'lazy' }}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
        {%- if section.settings.footer_about != blank -%}<p class="bf-foot__about">{{ section.settings.footer_about }}</p>{%- endif -%}
        <div class="bf-social">
          {%- if section.settings.social_instagram != blank -%}<a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>{%- endif -%}
          {%- if section.settings.social_facebook != blank -%}<a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8z"/></svg></a>{%- endif -%}
          {%- if section.settings.social_youtube != blank -%}<a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8zM10 15V9l5.2 3L10 15z"/></svg></a>{%- endif -%}
          {%- if section.settings.social_x != blank -%}<a href="{{ section.settings.social_x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg></a>{%- endif -%}
        </div>
      </div>

      <div>
        <h2>Shop</h2>
        <ul>
          {%- if section.settings.footer_menu != blank -%}
            {%- for link in section.settings.footer_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="#shop">Black Friday deals</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div>
        <h2>Help</h2>
        <ul>
          <li><a href="{{ section.settings.about_url | default: '/pages/about-us' }}">About us</a></li>
          <li><a href="{{ section.settings.contact_url | default: '/pages/contact' }}">Contact us</a></li>
          {%- if shop.privacy_policy -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>{%- endif -%}
          {%- if shop.terms_of_service -%}<li><a href="{{ shop.terms_of_service.url }}">Terms &amp; conditions</a></li>{%- endif -%}
          {%- if shop.shipping_policy -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping policy</a></li>{%- endif -%}
          {%- if shop.refund_policy -%}<li><a href="{{ shop.refund_policy.url }}">Return &amp; refund policy</a></li>{%- endif -%}
        </ul>
      </div>

      <div>
        <h2>Deal alerts</h2>
        {%- form 'customer', id: 'bf-foot-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.subscriber_tag }},newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <div class="bf-inline-form">
            <label class="bf-sr" for="bf-foot-email">Email address</label>
            <input class="bf-input" type="email" id="bf-foot-email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
            <button type="submit" class="bf-btn bf-btn--ghost">Join</button>
          </div>
          {%- if form.errors -%}<div class="bf-form-msg bf-form-msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        {%- endform -%}
      </div>
    </div>
    <div class="bf-foot__base">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>Payments are processed securely by Shopify checkout.</span>
    </div>
  </div>
</footer>
{%- endif -%}

{%- endif -%}
{%- comment -%} ===================== QUICK VIEW ===================== {%- endcomment -%}
<dialog class="bf-qv" id="bf-qv" aria-labelledby="bf-qv-title">
  <div class="bf-qv__card">
    <button type="button" class="bf-x" data-close aria-label="Close quick view"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
    <div class="bf-qv__body" data-qv-body></div>
  </div>
</dialog>

{%- comment -%} ===================== CART DRAWER ===================== {%- endcomment -%}
<dialog class="bf-drawer" id="bf-cart" aria-labelledby="bf-cart-title">
  <div class="bf-drawer__panel">
    <div class="bf-drawer__head">
      <h2 id="bf-cart-title">Your cart</h2>
      <button type="button" class="bf-x" data-close aria-label="Close cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
    </div>
    <ul class="bf-drawer__items" data-cart-items aria-live="polite"></ul>
    <div class="bf-drawer__foot" data-cart-foot hidden>
      <div class="bf-sum" data-cart-sum></div>
      <button type="button" class="bf-btn bf-btn--gold bf-btn--block" data-checkout>Proceed to checkout</button>
      <button type="button" class="bf-btn bf-btn--ghost bf-btn--block" data-close>Continue shopping</button>
      <p class="bf-fine" style="text-align:center">Shipping and discount codes are applied at checkout.</p>
    </div>
  </div>
</dialog>

{%- comment -%} ===================== WELCOME / SIGNUP POPUP ===================== {%- endcomment -%}
{%- if section.settings.show_popup -%}
<dialog class="bf-pop" id="bf-popup" aria-labelledby="bf-pop-title">
  <div class="bf-pop__card">
    {%- unless section.settings.require_signup -%}
      <button type="button" class="bf-x" data-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
    {%- endunless -%}

    {%- form 'customer', id: 'bf-popup-form', class: 'bf-pop-form', novalidate: 'novalidate' -%}
      {%- liquid
        assign state = ''
        if form.posted_successfully?
          assign state = 'success'
        elsif form.errors
          assign email_err = form.errors.messages['email'] | downcase
          if email_err contains 'taken' or email_err contains 'exist' or email_err contains 'already'
            assign state = 'returning'
          else
            assign state = 'error'
          endif
        endif
      -%}
      <span hidden data-form-state="{{ state }}"></span>

      <div data-pop-step="form"{% if state == 'success' or state == 'returning' %} hidden{% endif %}>
        <h2 class="bf-pop__title" id="bf-pop-title">{{ section.settings.popup_heading }}</h2>
        <p class="bf-pop__sub">{{ section.settings.popup_sub }}</p>

        <input type="hidden" name="contact[tags]" value="{{ section.settings.subscriber_tag }},newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <input type="hidden" name="contact[first_name]" data-first>
        <input type="hidden" name="contact[last_name]" data-last>

        <div class="bf-field">
          <label for="bf-pop-name">Full name</label>
          <input class="bf-input" id="bf-pop-name" type="text" autocomplete="name" placeholder="Your full name" required data-name aria-describedby="bf-pop-name-err">
          <span class="bf-err" id="bf-pop-name-err" aria-live="polite"></span>
        </div>
        <div class="bf-field">
          <label for="bf-pop-email">Email address</label>
          <input class="bf-input" id="bf-pop-email" type="email" name="contact[email]" autocomplete="email" placeholder="you@example.com" required data-email aria-describedby="bf-pop-email-err">
          <span class="bf-err" id="bf-pop-email-err" aria-live="polite"></span>
        </div>
        <label class="bf-check">
          <input type="checkbox" required data-consent aria-describedby="bf-pop-consent-err">
          <span>I agree to receive Black Friday offers and marketing emails, and accept the {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener">privacy policy</a>{% else %}privacy policy{% endif %}.</span>
        </label>
        <span class="bf-err" id="bf-pop-consent-err" aria-live="polite" style="display:block;margin:-12px 0 14px"></span>

        {%- if state == 'error' -%}
          <div class="bf-form-msg bf-form-msg--err" role="alert" style="margin:0 0 16px">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <button type="submit" class="bf-btn bf-btn--gold bf-btn--block">Continue shopping</button>
        {%- unless section.settings.require_signup -%}
          <button type="button" class="bf-pop__skip" data-close>Browse without joining</button>
        {%- endunless -%}
      </div>

      <div class="bf-pop__done" data-pop-step="done"{% unless state == 'success' or state == 'returning' %} hidden{% endunless %}>
        <div class="bf-pop__mark" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
        {%- if state == 'returning' -%}
          <h2 class="bf-pop__title">Welcome back</h2>
          <p class="bf-pop__sub">You’re already on our list, so your Black Friday access is ready.</p>
        {%- else -%}
          <h2 class="bf-pop__title">You’re in</h2>
          <p class="bf-pop__sub">Your Black Friday access is unlocked. Subscriber offers will arrive in your inbox.</p>
        {%- endif -%}
        <button type="button" class="bf-btn bf-btn--gold bf-btn--block" data-start-shopping>Start shopping</button>
      </div>
    {%- endform -%}
  </div>
</dialog>
{%- endif -%}

<div class="bf-toast" data-toast role="status" aria-live="polite"></div>

<script>
(() => {
  'use strict';
  const root = document.querySelector('[data-bf]');
  if (!root) return;
  const CFG = JSON.parse(document.getElementById('bf-config').textContent);
  const R = (window.Shopify && Shopify.routes && Shopify.routes.root) || CFG.root || '/';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => Array.from(el.querySelectorAll(s));
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const cdn = (u, w) => { if (!u) return ''; if (typeof u === 'object') u = u.src || u.url || ''; if (u.startsWith('//')) u = 'https:' + u; return u + (u.includes('?') ? '&' : '?') + 'width=' + w; };

  /* ---------- Money (uses the shop's own money format) ---------- */
  function money(cents) {
    cents = Number(cents) || 0;
    const fmt = (n, d, ts = ',', ds = '.') => {
      const [i, f] = (n / 100).toFixed(d).split('.');
      return i.replace(/\B(?=(\d{3})+(?!\d))/g, ts) + (f ? ds + f : '');
    };
    const tpl = String(CFG.moneyFormat || '{{amount}}').replace(/<[^>]*>/g, '');
    return tpl.replace(/\{\{\s*(\w+)\s*\}\}/, (_, k) => ({
      amount: fmt(cents, 2),
      amount_no_decimals: fmt(cents, 0),
      amount_with_comma_separator: fmt(cents, 2, '.', ','),
      amount_no_decimals_with_comma_separator: fmt(cents, 0, '.', ','),
      amount_with_apostrophe_separator: fmt(cents, 2, "'", '.'),
      amount_no_decimals_with_space_separator: fmt(cents, 0, ' ', ''),
      amount_with_space_separator: fmt(cents, 2, ' ', ',')
    })[k] || fmt(cents, 2));
  }

  /* ---------- Cookies (session flag only, never customer data) ---------- */
  const getCookie = (n) => (document.cookie.match('(?:^|; )' + n + '=([^;]*)') || [])[1];
  const setCookie = (n, v, days) => { document.cookie = n + '=' + v + '; path=/; max-age=' + days * 86400 + '; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : ''); };

  /* ---------- Toast ---------- */
  const toastEl = $('[data-toast]');
  let toastT;
  function toast(msg, err) {
    toastEl.textContent = msg;
    toastEl.classList.toggle('is-err', !!err);
    toastEl.classList.add('is-show');
    clearTimeout(toastT);
    toastT = setTimeout(() => toastEl.classList.remove('is-show'), 2800);
  }

  /* ---------- Dialog helpers (native <dialog> = focus trap + inert page) ---------- */
  const lastFocus = new WeakMap();
  function openDialog(d) {
    if (!d || d.open) return;
    lastFocus.set(d, document.activeElement);
    d.showModal();
    requestAnimationFrame(() => d.classList.add('is-open'));
  }
  function closeDialog(d) {
    if (!d || !d.open) return;
    if (d.id === 'bf-popup' && isGated()) return;
    d.classList.remove('is-open');
    setTimeout(() => { d.close(); const f = lastFocus.get(d); if (f && f.focus) f.focus(); }, reduce ? 0 : 380);
  }
  $$('dialog', root).forEach((d) => {
    d.addEventListener('cancel', (e) => { e.preventDefault(); closeDialog(d); });
    d.addEventListener('click', (e) => { if (e.target === d) closeDialog(d); });
  });

  /* ---------- Header ---------- */
  const head = $('[data-head]', root);
  if (head) {
    const onScroll = () => head.classList.toggle('is-solid', scrollY > 24);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }

  /* ---------- Countdowns ---------- */
  const timers = $$('[data-countdown]', root).map((el) => ({ el, end: Date.parse(el.dataset.countdown), last: {} }));
  function tick() {
    const now = Date.now();
    timers.forEach((t) => {
      if (isNaN(t.end)) return;
      let diff = Math.max(0, t.end - now);
      if (diff === 0 && !t.done) {
        t.done = true;
        t.el.innerHTML = '<span class="bf-ended">' + (t.el.hasAttribute('data-compact') ? 'This offer has ended' : 'The sale has ended') + '</span>';
        return;
      }
      const v = { d: Math.floor(diff / 864e5), h: Math.floor(diff / 36e5) % 24, m: Math.floor(diff / 6e4) % 60, s: Math.floor(diff / 1e3) % 60 };
      for (const k in v) {
        const n = t.el.querySelector('[data-unit="' + k + '"]');
        if (!n) continue;
        const txt = String(v[k]).padStart(2, '0');
        if (t.last[k] !== txt) {
          n.textContent = txt;
          if (t.last[k] !== undefined && n.classList.contains('bf-count__num')) { n.classList.remove('is-tick'); void n.offsetWidth; n.classList.add('is-tick'); }
          t.last[k] = txt;
        }
      }
    });
  }
  if (timers.length) { tick(); setInterval(tick, 1000); }

  /* ---------- Gold dust (hero only, paused off-screen) ---------- */
  const cv = $('[data-dust]', root);
  if (cv && !reduce) {
    const ctx = cv.getContext('2d');
    let w = 0, h = 0, running = false, visible = true;
    const parts = [];
    const size = () => { const dpr = Math.min(devicePixelRatio || 1, 2); w = cv.clientWidth; h = cv.clientHeight; cv.width = w * dpr; cv.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
    size(); addEventListener('resize', size);
    const N = innerWidth < 700 ? 22 : 46;
    for (let i = 0; i < N; i++) parts.push({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.5 + .4, s: Math.random() * .3 + .07, a: Math.random() * .5 + .15, t: Math.random() * 6.28 });
