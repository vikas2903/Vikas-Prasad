          endif
        -%}
        <article class="bf-card{% unless product.available %} is-soldout{% endunless %}" data-card data-handle="{{ product.handle }}" data-type="{{ product.type | escape }}" data-price="{{ product.price }}" data-available="{{ product.available }}" data-pct="{{ bf_pct }}"><div class="bf-card__media"><a href="{{ product.url }}" class="bf-card__link" data-quickview="{{ product.handle }}" tabindex="-1" aria-hidden="true">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,750,900', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title, class: 'bf-card__img' }}{% else %}<span class="bf-card__noimg">{{ product.title }}</span>{% endif %}</a>{% if bf_pct > 0 %}<span class="bf-badge">Black Friday deal</span><span class="bf-pct" aria-label="{{ bf_pct }} percent off">−{{ bf_pct }}%</span>{% endif %}<button type="button" class="bf-card__qv" data-quickview="{{ product.handle }}">Quick view<span class="bf-sr"> {{ product.title }}</span></button></div><div class="bf-card__body"><h3 class="bf-card__title"><a href="{{ product.url }}" data-quickview="{{ product.handle }}">{{ product.title }}</a></h3><p class="bf-price"><span class="bf-price__now">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>{% if bf_pct > 0 %}<s class="bf-price__was">{{ product.compare_at_price | money }}</s>{% endif %}</p>{% if product.available %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" {% if product.has_only_default_variant %}data-add="{{ product.first_available_variant.id }}"{% else %}data-quickview="{{ product.handle }}"{% endif %}>{% if product.has_only_default_variant %}Add to cart{% else %}Choose options{% endif %}</button>{% else %}<button type="button" class="bf-btn bf-btn--line bf-btn--block" disabled>Sold out</button>{% endif %}</div></article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ===================== C. LIMITED-TIME OFFERS ===================== {%- endcomment -%}
{%- if limited_col != blank and limited_col.products_count > 0 -%}
<section class="bf-section" id="limited" aria-labelledby="bf-limited-title">
