  .bf-line__title { font: 500 1rem/1.3 var(--serif); text-decoration: none; }
  .bf-line__var, .bf-line__price { margin: 4px 0 0; font-size: .82rem; color: var(--ash); }
  .bf-line__price s { margin-left: 6px; }
  .bf-line__ctrl { display: flex; align-items: center; gap: 14px; margin-top: 12px; }
  .bf-line__rm { background: none; border: 0; color: var(--ash); font-size: .8rem; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; padding: 0; }
  .bf-line__rm:hover { color: var(--danger); }
  .bf-line__total { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .bf-line.is-busy { opacity: .45; pointer-events: none; }
  .bf-drawer__foot { padding: 20px 24px calc(24px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--line); display: grid; gap: 10px; background: linear-gradient(180deg, rgba(201, 166, 101, .05), transparent); }
  .bf-sum { display: grid; gap: 8px; margin-bottom: 8px; }
  .bf-sum__row { display: flex; justify-content: space-between; font-size: .9rem; color: var(--ash); font-variant-numeric: tabular-nums; }
  .bf-sum__row--save { color: var(--gold-hi); font-weight: 600; }
  .bf-sum__row--total { color: var(--bone); font: 500 1.35rem/1.2 var(--serif); padding-top: 10px; border-top: 1px solid var(--line); margin-top: 4px; }
  .bf-cart-empty { text-align: center; padding: 72px 12px; color: var(--ash); }
  .bf-cart-empty h3 { font: 500 1.5rem/1.2 var(--serif); color: var(--bone); margin: 0 0 8px; }
  .bf-cart-empty p { margin: 0 0 24px; }

  /* ---------- Skeleton, toast, reveal ---------- */
  .bf-skel { background: linear-gradient(90deg, #17140F 0%, #2A251B 50%, #17140F 100%); background-size: 200% 100%; animation: bf-shimmer 1.3s linear infinite; border-radius: 2px; }
  @keyframes bf-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
  .bf-skel-line { display: grid; grid-template-columns: 84px 1fr; gap: 16px; padding: 20px 0; }
  .bf-skel-line .bf-skel:first-child { aspect-ratio: 4 / 5; }
  .bf-skel-line div:last-child { display: grid; gap: 10px; align-content: start; }
  .bf-skel-line div:last-child .bf-skel { height: 12px; }
  .bf-toast { position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); z-index: 2147483000; transform: translate(-50%, 30px); opacity: 0; pointer-events: none; background: var(--bone); color: #000; padding: 14px 22px; border-radius: 999px; font-weight: 600; font-size: .9rem; box-shadow: 0 20px 50px -10px rgba(0, 0, 0, .7); transition: opacity .4s var(--ease), transform .4s var(--ease); display: flex; gap: 10px; align-items: center; max-width: calc(100% - 32px); }
  .bf-toast.is-show { opacity: 1; transform: translate(-50%, 0); }
  .bf-toast.is-err { background: var(--danger); }
  .bf-toast::before { content: "✦"; color: var(--gold-lo); }
  [data-reveal] { opacity: 0; transform: translateY(26px); transition: opacity 1s var(--ease), transform 1s var(--ease); }
  [data-reveal].is-in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .bf *, .bf *::before, .bf *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
    [data-reveal] { opacity: 1; transform: none; }
    .bf-marquee__track { animation: none; }
  }
</style>

{%- comment -%} ===================== HEADER ===================== {%- endcomment -%}
{%- if section.settings.show_section_header -%}
<header class="bf-head" data-head>
  <div class="bf-wrap bf-head__in">
    <a href="{{ routes.root_url }}" class="bf-logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
    <nav class="bf-nav" aria-label="Page sections">
      <a href="#shop">Shop products</a>
    </nav>
    <button type="button" class="bf-bagbtn" data-cart-open aria-haspopup="dialog" aria-controls="bf-cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
      <span>Cart</span>
      <span class="bf-bagcount" data-cart-count>{{ cart.item_count }}</span>
      <span class="bf-sr">items</span>
    </button>
  </div>
</header>
{%- endif -%}

<main id="bf-main">

{%- comment -%} ===================== HERO ===================== {%- endcomment -%}
<section class="bf-hero" aria-labelledby="bf-hero-title">
  <canvas class="bf-hero__dust" data-dust aria-hidden="true"></canvas>
  <div class="bf-wrap bf-hero__grid">
    <div class="bf-hero__copy">
      {%- if section.settings.hero_dates != blank -%}
        <p class="bf-hero__dates">{{ section.settings.hero_dates }}</p>
      {%- endif -%}
      <h1 id="bf-hero-title" class="bf-hero__title">{{ section.settings.hero_heading }}</h1>
      <p class="bf-hero__sub">{{ section.settings.hero_sub }}</p>

      <div class="bf-hero__ctas">
        <a href="#shop" class="bf-btn bf-btn--gold">Shop Black Friday deals</a>
        <a href="#shop" class="bf-btn bf-btn--ghost">Explore collection</a>
      </div>
    </div>

    <div class="bf-hero__visual">
      <div class="bf-arch-ring" aria-hidden="true"></div>
      <div class="bf-arch">
        {%- if hero_img != blank -%}
          {{ hero_img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480,720,960,1200', sizes: '(min-width: 900px) 480px, 78vw', alt: hero_alt }}
        {%- endif -%}
      </div>
      <div class="bf-seal" aria-hidden="true">
        <svg viewBox="0 0 100 100"><defs><path id="bf-circ" d="M50,50 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0"/></defs><text><textPath href="#bf-circ">Black Friday ✦ Black Friday ✦ Black Friday ✦</textPath></text></svg>
        <div class="bf-seal__core">
          {%- if max_pct > 0 -%}
            <small>up to</small><strong>{{ max_pct }}%</strong><small>off</small>
          {%- else -%}
            <strong>BF</strong><small>{{ 'now' | date: '%Y' }}</small>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- if section.settings.banner_text != blank -%}
  {%- assign banner_items = section.settings.banner_text | split: '|' -%}
  <div class="bf-marquee" role="region" aria-label="Promotion">
    <div class="bf-marquee__track">
      {%- for i in (1..2) -%}
        {%- for item in banner_items -%}
          <span class="bf-marquee__item"{% if i == 2 %} aria-hidden="true"{% endif %}>{{ item | strip }}</span>
        {%- endfor -%}
        {%- for item in banner_items -%}
          <span class="bf-marquee__item" aria-hidden="true">{{ item | strip }}</span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- comment -%} ===================== SALE TIMER ===================== {%- endcomment -%}
{%- if end_at != blank -%}
<section class="bf-timer" aria-labelledby="bf-timer-title">
  <div class="bf-wrap bf-timer__in">
    <div>
      <span class="bf-timer__eyebrow">Limited Black Friday event</span>
      <h2 class="bf-h2" id="bf-timer-title">{{ section.settings.timer_heading }}</h2>
    </div>
    <div class="bf-count" data-countdown="{{ end_at }}" role="timer" aria-label="Time left in the sale">
      <div class="bf-count__cell"><span class="bf-count__num" data-unit="d">00</span><span class="bf-count__lbl">days</span></div>
      <div class="bf-count__cell"><span class="bf-count__num" data-unit="h">00</span><span class="bf-count__lbl">hours</span></div>
      <div class="bf-count__cell"><span class="bf-count__num" data-unit="m">00</span><span class="bf-count__lbl">minutes</span></div>
      <div class="bf-count__cell"><span class="bf-count__num" data-unit="s">00</span><span class="bf-count__lbl">seconds</span></div>
    </div>
  </div>
</section>
{%- endif -%}

{%- if false -%}
{%- comment -%} ===================== LIVE SALE OFFERS ===================== {%- endcomment -%}
{%- if section.settings.show_sale_offers -%}
<section class="bf-offers" id="offers" aria-labelledby="bf-offers-title">
  <div class="bf-wrap">
    <div class="bf-offers__head" data-reveal>
