        <article class="bf-offer" data-sale-offer data-required="{{ section.settings.offer_3for_required }}" data-offer-name="{{ section.settings.offer_3for_title | escape }}" data-offer-suffix="{{ section.settings.offer_3for_suffix | escape }}" data-reveal>
          <span class="bf-offer__eyebrow">Black Friday special</span>
          <h3>{{ section.settings.offer_3for_title }}</h3>
